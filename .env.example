# Required only on the server for direct Gemini API calls.
# Locally: copy this file to .env and set GEMINI_API_KEY.
# Netlify: configure GEMINI_API_KEY as a secret environment variable
# for the server runtime in the required deploy contexts, then redeploy.
# Never prefix this variable with VITE_ or commit your .env file.
GEMINI_API_KEY=
